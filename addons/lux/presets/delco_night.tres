ambient_energy = 0.55
room_probes_replace_ambient = true
tonemap_mode = 3
exposure = 1.15
tonemap_white = 6.0
brightness = 1.0
contrast = 1.08
saturation = 0.96
warmth = 0.05
fog_enabled = true
