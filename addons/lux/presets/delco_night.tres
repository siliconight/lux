[resource]
script = ExtResource("1_preset")
preset_name = &"Delco Night"
description = "Night on a 1997 Delco strip: no sun, practicals carry it -- streetlight sodium, canopy fluorescent, emissive sign faces. THE LIGHT LEVELS ARE NOT NEW. sky_energy 0.35 and ambient_energy 0.55 are Gothic Street Night's, the one night preset in this library that has actually been tuned, and they are copied rather than guessed; only the palette and the ambient hue are Delco's. Blue Hour was what a `night` brief used to get, and it is dusk -- a 4 degree sun at 0.9 energy over 0.9 ambient, which washed out every fixture in the level."
sky_top_color = Color(0.05, 0.06, 0.11, 1)
sky_horizon_color = Color(0.12, 0.13, 0.19, 1)
ground_color = Color(0.03, 0.03, 0.05, 1)
sky_energy = 0.35
sun_enabled = false
