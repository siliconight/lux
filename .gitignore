# Godot 4+ specific ignores
.godot/
/android/

# Godot-specific export presets with secrets
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono/C# build artifacts (not used here, kept for safety)
.mono/
data_*/
mono_crash.*.json

# Editor/OS cruft
*.tmp
*.swp
.DS_Store
Thumbs.db
walk/headless/

# editor backups from patch_*.py -- copies of tracked files, not history.
# A RULE, not a list: each patch invents its own suffix.
*.pre_*
